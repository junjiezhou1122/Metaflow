{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": [
    "packages/view/**/*.ts",
    "packages/transformation/**/*.ts",
    "packages/execution/**/*.ts",
    "packages/automation/**/*.ts",
    "packages/capture/**/*.ts",
    "packages/operations/**/*.ts",
    "packages/adapters/**/*.ts",
    "apps/ambient-daemon/**/*.ts",
    "scripts/v1/**/*.ts"
  ],
  "exclude": ["node_modules", "packages/*/node_modules/**"]
}
