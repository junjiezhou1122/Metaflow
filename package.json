{
  "name": "metaflow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx apps/ambient-daemon/index.ts",
    "http": "node --experimental-sqlite --import tsx apps/ambient-daemon/index.ts",
    "ambient:daemon": "node --experimental-sqlite --import tsx apps/ambient-daemon/index.ts",
    "mf": "node --no-warnings --experimental-sqlite --import tsx scripts/v1/operations-cli.ts",
    "mcp": "node --no-warnings --experimental-sqlite --import tsx scripts/v1/operations-mcp.ts",
    "browser:build": "pnpm --dir apps/chrome-acp/packages/chrome-extension run build",
    "website:dev": "pnpm --dir apps/website run dev",
    "website:build": "pnpm --dir apps/website run build",
    "website:preview": "pnpm --dir apps/website run preview",
    "mac:build": "swift build --package-path apps/mac",
    "mac:bundle": "apps/mac/scripts/build-app.sh",
    "mac:run": "apps/mac/scripts/build-app.sh --open",
    "test": "node --import tsx scripts/v1/run-tests.ts",
    "test:v1": "node --import tsx scripts/v1/run-tests.ts",
    "test:view-contract": "node --import tsx --test tests/view-contract.test.ts",
    "test:view-commit-events": "node --experimental-sqlite --import tsx --test tests/view-commit-events.test.ts",
    "test:committed-view-trigger": "node --experimental-sqlite --import tsx --test tests/committed-view-trigger.test.ts",
    "test:reactive-cascade": "node --experimental-sqlite --import tsx --test tests/reactive-cascade.test.ts",
    "test:iii-runtime": "node --experimental-sqlite --import tsx --test tests/iii-runtime.test.ts",
    "test:transformation-contract": "node --import tsx --test tests/transformation-contract.test.ts",
    "test:view-access-policy": "node --import tsx --test tests/view-access-policy.test.ts",
    "test:execution-runtime": "node --experimental-sqlite --import tsx --test tests/execution-runtime.test.ts",
    "test:v1-vertical": "node --experimental-sqlite --import tsx --test tests/metaflow-v1-vertical.test.ts",
    "test:feedback-evolution": "node --experimental-sqlite --import tsx --test tests/feedback-evolution.test.ts",
    "test:failure-repair": "node --experimental-sqlite --import tsx --test tests/failure-repair.test.ts",
    "test:browser-capture": "node --experimental-sqlite --import tsx --test tests/browser-capture.test.ts tests/browser-automation.test.ts tests/browser-automation-extension.test.ts tests/browser-automation-http.test.ts tests/ambient-daemon-vertical.test.ts",
    "test:screenpipe-capture": "node --experimental-sqlite --import tsx --test tests/screenpipe-capture.test.ts",
    "test:obsidian-capture": "node --experimental-sqlite --import tsx --test tests/obsidian-capture.test.ts",
    "test:codex-history-capture": "node --experimental-sqlite --import tsx --test tests/codex-history-capture.test.ts",
    "test:web-view-renderers": "node --import tsx --test packages/adapters/web-view-renderers/web-view-renderers.test.ts tests/view-package.test.ts",
    "test:connector-kit": "node --experimental-sqlite --import tsx --test tests/connector-kit.test.ts tests/capture-runtime.test.ts",
    "test:operation-surfaces": "node --experimental-sqlite --import tsx --test tests/operation-surfaces.test.ts",
    "test:view-operators": "node --experimental-sqlite --import tsx --test tests/view-operators.test.ts",
    "test:view-store": "node --experimental-sqlite --import tsx --test tests/view-store.test.ts",
    "test:view-search": "node --experimental-sqlite --import tsx --test tests/view-search-projection.test.ts tests/view-search-service.test.ts tests/view-search-semantic.test.ts",
    "test:view-search-semantic": "node --no-warnings --experimental-sqlite --import tsx --test tests/view-search-semantic.test.ts tests/operation-surfaces.test.ts",
    "test:view-graph-project": "node --experimental-sqlite --import tsx --test tests/view-graph-project.test.ts tests/operation-surfaces.test.ts",
    "test:privacy-forget": "node --experimental-sqlite --import tsx --test tests/privacy-forget.test.ts tests/capture-runtime.test.ts",
    "test:view-v1": "node --experimental-sqlite --import tsx --test tests/view-contract.test.ts tests/view-store.test.ts tests/view-v1.test.ts",
    "test:boundaries": "node --import tsx --test tests/package-boundaries.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.v1.json",
    "typecheck:v1": "tsc --noEmit -p tsconfig.v1.json",
    "check:boundaries": "depcruise --config dependency-cruiser.config.cjs packages/view packages/view-package packages/transformation packages/execution packages/automation packages/capture packages/search packages/operations packages/adapters view-packages && tsx scripts/check-v1-package-manifests.ts",
    "verify:v1:boundaries": "pnpm typecheck:v1 && pnpm check:boundaries && pnpm test:boundaries"
  },
  "dependencies": {
    "@info/agent-runtime-adapter": "workspace:*",
    "@info/automation": "workspace:*",
    "@info/automation-execution-adapter": "workspace:*",
    "@info/automation-sqlite": "workspace:*",
    "@info/browser-automation-adapter": "workspace:*",
    "@info/browser-capture-adapter": "workspace:*",
    "@info/codex-history-capture-adapter": "workspace:*",
    "@info/capture": "workspace:*",
    "@info/execution": "workspace:*",
    "@info/function-operator-adapter": "workspace:*",
    "@info/inbox-automation-adapter": "workspace:*",
    "@info/iii-runtime-adapter": "workspace:*",
    "@info/macos-automation-adapter": "workspace:*",
    "@info/operation-surfaces": "workspace:*",
    "@info/obsidian-capture-adapter": "workspace:*",
    "@info/operations": "workspace:*",
    "@info/search": "workspace:*",
    "@info/scheduler-automation-adapter": "workspace:*",
    "@info/screenpipe-capture-adapter": "workspace:*",
    "@info/storage-sqlite": "workspace:*",
    "@info/transformation": "workspace:*",
    "@info/transformation-sqlite": "workspace:*",
    "@info/view": "workspace:*",
    "@info/view-package": "workspace:*",
    "@info/web-view-renderers": "workspace:*",
    "iii-sdk": "0.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dependency-cruiser": "18.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "zod": "^3.24.4"
  },
  "pnpm": {
    "overrides": {
      "@agentclientprotocol/claude-agent-acp>zod": "^4.4.3"
    }
  }
}
