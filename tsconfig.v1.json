{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "packages/view/**/*.ts",
    "packages/view-package/**/*.ts",
    "packages/authoring/**/*.ts",
    "packages/transformation/**/*.ts",
    "packages/execution/**/*.ts",
    "packages/automation/**/*.ts",
    "packages/capture/**/*.ts",
    "packages/search/**/*.ts",
    "packages/operations/**/*.ts",
    "packages/screenpipe-contracts/**/*.ts",
    "packages/adapters/**/*.ts",
    "packages/adapters/**/*.tsx",
    "view-packages/**/*.ts",
    "apps/ambient-daemon/**/*.ts",
    "scripts/v1/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests"
  ]
}
